# Copy to `.env` (same folder) to use your own map servers. All are optional.
# After changing, run `npm run build` again. See docs/index.md, "Self-hosting map services".

# Raster tiles ({z}/{x}/{y} are filled in by the map). Keep the OpenStreetMap credit.
# VITE_TILE_URL=https://tiles.example.com/tile/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Address search (Photon) and driving routes (OSRM): base URLs, no trailing path.
# VITE_PHOTON_URL=https://photon.example.com
# VITE_OSRM_URL=https://osrm.example.com
